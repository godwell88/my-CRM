// prisma/schema.prisma
generator client {
  provider = "prisma-client"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  phone            String   
  address          String?
  interaction      String?
  productsEnquired String?
  productsBought   String?
  notes            String?
  source           String[]
  createdAt        DateTime @default(now())

  

}

model user{
  id String @id @default(uuid())
  name String
  email String
  age Int
  
}


enum ROLES {
  ADMIN
  SALES_ASSISTANT
}

